{
  "require_signed_prompts": false,
  "allowed_writable_paths": [
    "tmp/",
    "scratch/"
  ],
  "audit_enabled": true,
  "deny_shell_exec": true,
  "deny_file_ops": true,
  "enforce_git_policy": true,
  "allowed_prompt_patterns": [
    "^/describe",
    "^/summarize",
    "^/format",
    "^/explain",
    "^/readonly-check"
  ],
  "agent_name": "Antigravity-Strict"
}
